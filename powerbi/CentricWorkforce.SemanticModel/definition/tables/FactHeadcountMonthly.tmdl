/// One row per person and month employed (from the SCD2 history). SIMULATED.
table FactHeadcountMonthly
	lineageTag: 39a51f71-3ccf-5401-9c0b-e1b1480a9061

	column MonthStart
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 8fa3fa4b-3f87-50d3-883b-6e0af8f1d99a
		summarizeBy: none
		sourceColumn: MonthStart

		annotation UnderlyingDateTimeDataType = Date

	column EmployeeKey
		dataType: string
		isHidden
		lineageTag: e306f1da-506f-5556-91a3-53bd4db23cbe
		summarizeBy: none
		sourceColumn: EmployeeKey

	column EmployeeId
		dataType: string
		lineageTag: b2af53e2-0833-5f5c-a40e-6f96b158de0b
		summarizeBy: none
		sourceColumn: EmployeeId

	column CostCenter
		dataType: string
		isHidden
		lineageTag: 5127427d-70e6-5f6c-bfa0-7ac5b5c83c24
		summarizeBy: none
		sourceColumn: CostCenter

	column Grade
		dataType: string
		isHidden
		lineageTag: 6be86f21-3ed7-5e31-a27e-b43a43506d88
		summarizeBy: none
		sourceColumn: Grade

	column FTE
		dataType: double
		formatString: 0.0
		lineageTag: b7b387ba-1d4a-5fa4-9e48-39f3bdbedc5c
		summarizeBy: none
		sourceColumn: FTE

	column SalaryMonthlyGross
		dataType: double
		formatString: €#,0
		lineageTag: 5e72a5c1-0251-5eec-8fc6-101a64884022
		summarizeBy: none
		sourceColumn: SalaryMonthlyGross

	column TenureMonths
		dataType: int64
		lineageTag: 98eff132-da35-5b4a-a7ea-7295413efed3
		summarizeBy: none
		sourceColumn: TenureMonths

	column TenureBand
		dataType: string
		lineageTag: 1b9e997c-9eb4-52b6-b200-7ac5c2516fb3
		summarizeBy: none
		sourceColumn: TenureBand

	column IsActiveMonthEnd
		dataType: int64
		lineageTag: 0c881da9-2bb5-5fcd-99b8-e381aa15c442
		summarizeBy: none
		sourceColumn: IsActiveMonthEnd

	column IsDuplicateId
		dataType: int64
		lineageTag: 27d9a10c-a2a0-5c1d-a7b5-bbce380b321f
		summarizeBy: none
		sourceColumn: IsDuplicateId

	column IsNewHireInMonth
		dataType: int64
		lineageTag: 5ca119ff-6712-5ff1-a317-37e44a5c8bce
		summarizeBy: none
		sourceColumn: IsNewHireInMonth

	column CapacityHours
		dataType: double
		formatString: #,0
		lineageTag: 4cda9dea-b1c5-551c-a00c-462e9f30234b
		summarizeBy: none
		sourceColumn: CapacityHours

	column AbsenceDays
		dataType: double
		lineageTag: dc04ce43-ef3d-511d-a396-390677f9d26d
		summarizeBy: none
		sourceColumn: AbsenceDays

	partition FactHeadcountMonthly = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "FactHeadcountMonthly.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"MonthStart", type date}, {"EmployeeKey", type text}, {"EmployeeId", type text}, {"CostCenter", type text}, {"Grade", type text}, {"FTE", type number}, {"SalaryMonthlyGross", type number}, {"TenureMonths", Int64.Type}, {"TenureBand", type text}, {"IsActiveMonthEnd", Int64.Type}, {"IsDuplicateId", Int64.Type}, {"IsNewHireInMonth", Int64.Type}, {"CapacityHours", type number}, {"AbsenceDays", type number}}, "en-US")
				in
					Typed
