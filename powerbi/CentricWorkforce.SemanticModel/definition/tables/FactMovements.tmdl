		sourceColumn: ToDepartment

	partition FactMovements = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "FactMovements.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"MovementId", type text}, {"Date", type date}, {"EmployeeId", type text}, {"EmployeeKey", type text}, {"MovementType", type text}, {"ExitType", type text}, {"ExitReason", type text}, {"IsRegretted", Int64.Type}, {"IsInternalTransfer", Int64.Type}, {"IsVoluntary", type number}, {"CostCenter", type text}, {"Grade", type text}, {"TenureMonths", Int64.Type}, {"TenureBand", type text}, {"FromDepartment", type text}, {"ToDepartment", type text}}, "en-US")
				in
					Typed
