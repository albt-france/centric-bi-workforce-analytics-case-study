/// Hires, exits and transfers with exit type, regretted flag and internal-transfer flag. SIMULATED.
table FactMovements
	lineageTag: 0867ba54-f290-5cb8-9dbf-eec8c354b04b

	column MovementId
		dataType: string
		lineageTag: edf3b377-1fcb-5834-940e-0a7fb69f77b5
		summarizeBy: none
		sourceColumn: MovementId

	column Date
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: ed121769-b9e9-5732-aa24-a84c505ab63e
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column EmployeeId
		dataType: string
		lineageTag: 8ef3d10c-d68e-5825-8c84-b5b7f22b76fb
		summarizeBy: none
