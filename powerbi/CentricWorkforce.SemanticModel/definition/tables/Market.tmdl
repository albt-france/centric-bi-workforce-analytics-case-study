	partition Market = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "Market.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"Quarter", type text}, {"LabourCostIndexICT", type number}, {"QuarterStart", type date}, {"LabourCostIndexICT_2024Q4_100", type number}, {"JobVacancyRateICT_LT", type number}, {"JobVacancyRateICT_EU27", type number}, {"JobVacancyRateICT_FR", type number}, {"AvgGrossEarningsICT_LT", type number}, {"AvgGrossEarningsAll_LT", type number}, {"ICTSpecialistsShare_LT", type number}, {"ICTSpecialistsShare_EU27", type number}, {"Source", type text}}, "en-US")
				in
					Typed
